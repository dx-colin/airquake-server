# net_dgrm.c — hand-rolled POSIX struct definitions use wrong-sized types
#
# The BAN_TEST #else fallback manually defines struct in_addr using
# 'unsigned long S_addr'. On 32-bit systems unsigned long is 4 bytes,
# so this works by coincidence. On 64-bit systems unsigned long is
# 8 bytes, making the struct twice as large as the real one and
# completely breaking all network address comparisons and packet
# handling. The fix replaces the hand-rolled definitions with
# standard POSIX #include directives.
#
# Note: This fix overlaps with bugfix/net_dgrm.c.patch (Fix 1).
# When BUGFIX=1, the build script skips this patch to avoid conflict.
#
--- net_dgrm.c
+++ net_dgrm.c
@@ -29,25 +29,8 @@
 #include <sys/socket.h>
 #include <arpa/inet.h>
 #else
-#define AF_INET 		2	/* internet */
-struct in_addr
-{
-	union
-	{
-		struct { unsigned char s_b1,s_b2,s_b3,s_b4; } S_un_b;
-		struct { unsigned short s_w1,s_w2; } S_un_w;
-		unsigned long S_addr;
-	} S_un;
-};
-#define	s_addr	S_un.S_addr	/* can be used for most tcp & ip code */
-struct sockaddr_in
-{
-    short			sin_family;
-    unsigned short	sin_port;
-	struct in_addr	sin_addr;
-    char			sin_zero[8];
-};
-char *inet_ntoa(struct in_addr in);
-unsigned long inet_addr(const char *cp);
+#include <sys/socket.h>
+#include <netinet/in.h>
+#include <arpa/inet.h>
 #endif
 #endif	// BAN_TEST
