# sv_main.c — worldmodel/mapname pointer arithmetic truncation on 64-bit
#
# SV_SpawnServer() sets progs global fields by subtracting pr_strings
# from pointers that live outside the progs string heap:
#
#     ent->v.model    = sv.worldmodel->name - pr_strings;
#     mapname         = sv.name - pr_strings;
#     startspot       = sv.startspot - pr_strings;  (Quake2 only)
#
# On 32-bit the pointer differences fit in an int. On 64-bit these
# pointers can be far apart in memory, producing truncated garbage
# offsets. QuakeC accesses to worldmodel name, mapname, or startspot
# then index into random memory instead of valid strings.
#
# The fix copies each string into the progs heap with ED_NewString()
# so the offset is always a small, valid value.
#
--- sv_main.c
+++ sv_main.c
@@ -1157,7 +1157,7 @@
 	ent = EDICT_NUM(0);
 	memset (&ent->v, 0, progs->entityfields * 4);
 	ent->free = false;
-	ent->v.model = sv.worldmodel->name - pr_strings;
+	ent->v.model = ED_NewString (sv.worldmodel->name) - pr_strings;
 	ent->v.modelindex = 1;		// world model
 	ent->v.solid = SOLID_BSP;
 	ent->v.movetype = MOVETYPE_PUSH;
@@ -1167,9 +1167,9 @@
 	else
 		pr_global_struct->deathmatch = deathmatch.value;
 
-	pr_global_struct->mapname = sv.name - pr_strings;
+	pr_global_struct->mapname = ED_NewString (sv.name) - pr_strings;
 #ifdef QUAKE2
-	pr_global_struct->startspot = sv.startspot - pr_strings;
+	pr_global_struct->startspot = ED_NewString (sv.startspot) - pr_strings;
 #endif
 
 // serverflags are for cross level information (sigils)
