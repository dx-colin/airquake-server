+
+static qboolean SV_TriggerChangelevelMap (char *out)
+{
+	eval_t *classname;
+	eval_t *map;
+	edict_t *ent;
+	int i;
+
+	for (i=1, ent = NEXT_EDICT(sv.edicts) ; i<sv.num_edicts ; i++, ent = NEXT_EDICT(ent))
+	{
+		if (ent->free)
+			continue;
+
+		classname = GetEdictFieldValue (ent, "classname");
+		if (!classname || !classname->string)
+			continue;
+		if (Q_strcasecmp (pr_strings + classname->string, "trigger_changelevel"))
+			continue;
+
+		map = GetEdictFieldValue (ent, "map");
+		if (!map || !map->string)
+			continue;
+		if (Q_strlen(pr_strings + map->string) >= MAX_QPATH)
+			continue;
+
+		Q_strcpy (out, pr_strings + map->string);
+		return true;
+	}
+
+	return false;
+}
+
+static void SV_MapCycleIdleRotate (void)
+{
+	char trigger_map[MAX_QPATH];
+	char rotated[MAX_QPATH];
+	char *target;
+	char *rotation;
+	double timeout;
+
+	if (!sv.active || svs.changelevel_issued)
+		return;
+
+	if (timelimit.value <= 0)
+		return;
+
+	if (net_activeconnections > 0)
+		return;
+
+	timeout = (timelimit.value + 1.0) * 60.0;
+	if (sv.time < timeout)
+		return;
+
+	target = sv.name;
+	rotation = Cvar_VariableString ("mapcycle");
+	if (rotation && rotation[0] && SV_MapCycleNext (rotation, rotated))
+		target = rotated;
+	else if (!Q_strcasecmp (sv.name, "start"))
+		target = "e1m1";
+	else if (SV_TriggerChangelevelMap (trigger_map))
+		target = trigger_map;
+
+	Con_DPrintf ("timelimit: forcing idle rotation to %s\n", target);
+	svs.changelevel_issued = true;
+	Cbuf_AddText (va("changelevel %s\n", target));
+}
